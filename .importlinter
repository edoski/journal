[importlinter]
root_packages =
    sync
    learning
include_external_packages = True

[importlinter:application_no_adapters]
name = Application layer must not import adapters
type = forbidden
source_modules =
    sync.application
forbidden_modules =
    sync.adapters

[importlinter:writers_no_ports_or_adapters]
name = Writers layer must stay pure render logic
type = forbidden
source_modules =
    sync.writers
forbidden_modules =
    sync.ports
    sync.adapters

[importlinter:writers_no_readers]
name = Writers must not import readers
type = forbidden
source_modules =
    sync.writers
forbidden_modules =
    sync.readers

[importlinter:contracts_no_ports_or_adapters_or_application]
name = Contracts layer must stay infrastructure-agnostic
type = forbidden
source_modules =
    sync.contracts
forbidden_modules =
    sync.ports
    sync.adapters
    sync.application

[importlinter:ports_no_adapters_or_application]
name = Ports layer must remain abstract interfaces
type = forbidden
source_modules =
    sync.ports
forbidden_modules =
    sync.adapters
    sync.application

[importlinter:readers_no_runtime_or_rendering]
name = Readers must stay parse-only
type = forbidden
source_modules =
    sync.readers
forbidden_modules =
    sync.application
    sync.adapters
    sync.io
    sync.writers
    sync.run

[importlinter:periods_no_runtime]
name = Period engine must stay runtime-agnostic
type = forbidden
source_modules =
    sync.periods
forbidden_modules =
    sync.run

[importlinter:sync_no_learning]
name = Journal sync must not depend on learning
type = forbidden
source_modules =
    sync
forbidden_modules =
    learning

[importlinter:domain_no_integration]
name = Domain modules must not construct integrations
type = forbidden
source_modules =
    sync.daily
    sync.study
    sync.metrics
    sync.periods
    sync.notes
forbidden_modules =
    sync.application
    sync.adapters

[importlinter:learning_study_context]
name = Learning reads journal data only through study context
type = forbidden
source_modules =
    learning
forbidden_modules =
    sync
allow_indirect_imports = True
ignore_imports =
    learning.cli -> sync.study.context
    learning.planning -> sync.study.context
