[importlinter]
root_package = sync
include_external_packages = True

[importlinter:application_no_adapters]
name = Application layer must not import adapters
type = forbidden
source_modules =
    sync.application
forbidden_modules =
    sync.adapters

[importlinter:writers_no_ports_or_adapters]
name = Writers layer must stay pure render logic
type = forbidden
source_modules =
    sync.writers
forbidden_modules =
    sync.ports
    sync.adapters

[importlinter:writers_no_readers]
name = Writers must not import readers
type = forbidden
source_modules =
    sync.writers
forbidden_modules =
    sync.readers

[importlinter:contracts_no_ports_or_adapters_or_application]
name = Contracts layer must stay infrastructure-agnostic
type = forbidden
source_modules =
    sync.contracts
forbidden_modules =
    sync.ports
    sync.adapters
    sync.application

[importlinter:ports_no_adapters_or_application]
name = Ports layer must remain abstract interfaces
type = forbidden
source_modules =
    sync.ports
forbidden_modules =
    sync.adapters
    sync.application
