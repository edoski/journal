[importlinter]
root_package = sync
include_external_packages = True

[importlinter:application_no_adapters]
name = Application layer must not import adapters
type = forbidden
source_modules =
    sync.application
forbidden_modules =
    sync.adapters

[importlinter:writers_no_ports_or_adapters]
name = Writers layer must stay pure render logic
type = forbidden
source_modules =
    sync.writers
forbidden_modules =
    sync.ports
    sync.adapters

[importlinter:writers_no_readers]
name = Writers must not import readers
type = forbidden
source_modules =
    sync.writers
forbidden_modules =
    sync.readers

[importlinter:contracts_no_ports_or_adapters_or_application]
name = Contracts layer must stay infrastructure-agnostic
type = forbidden
source_modules =
    sync.contracts
forbidden_modules =
    sync.ports
    sync.adapters
    sync.application

[importlinter:ports_no_adapters_or_application]
name = Ports layer must remain abstract interfaces
type = forbidden
source_modules =
    sync.ports
forbidden_modules =
    sync.adapters
    sync.application

[importlinter:readers_no_runtime_or_rendering]
name = Readers must stay parse-only
type = forbidden
source_modules =
    sync.readers
forbidden_modules =
    sync.application
    sync.adapters
    sync.writers
    sync.run

[importlinter:periods_no_runtime]
name = Period engine must stay runtime-agnostic
type = forbidden
source_modules =
    sync.periods
forbidden_modules =
    sync.run

[importlinter:goals_no_adapters]
name = Goals domain must not depend on adapters
type = forbidden
source_modules =
    sync.goals
forbidden_modules =
    sync.adapters
