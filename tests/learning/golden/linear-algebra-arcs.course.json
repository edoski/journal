  "arcs": {
    "spaces": {
      "title": "Vector spaces",
      "question": "How do a few vectors build a whole space, and how many does it take?",
      "purpose": "Tell whether vectors span a space, are independent, and form a basis.",
      "refs": [
        {
          "source": "notes",
          "locator": "Chapters 1 to 3"
        }
      ]
    },
    "systems": {
      "title": "Linear systems",
      "question": "When does a linear system have a solution, and how many?",
      "purpose": "Solve a system by elimination and read its solutions from rank and kernel.",
      "refs": [
        {
          "source": "notes",
          "locator": "Chapter 4"
        }
      ]
    },
    "determinants": {
      "title": "Determinants",
      "question": "What does one number say about a matrix and the volume it scales?",
      "purpose": "Compute determinants and use them to decide invertibility and solve small systems.",
      "refs": [
        {
          "source": "notes",
          "locator": "Chapter 5"
        }
      ]
    },
    "eigenvalues": {
      "title": "Eigenvalues and diagonalization",
      "question": "Which directions does a matrix only stretch, and what basis makes it simple?",
      "purpose": "Find eigenvalues and eigenvectors and diagonalize a matrix by a change of basis.",
      "refs": [
        {
          "source": "notes",
          "locator": "Chapter 6"
        }
      ]
    },
    "orthogonality": {
      "title": "Orthogonality",
      "question": "How do angles and lengths let us find the closest vector in a subspace?",
      "purpose": "Use inner products to test orthogonality and project onto a subspace.",
      "refs": [
        {
          "source": "notes",
          "locator": "Chapter 7"
        }
      ]
    }
  },
